# Application Configuration
APP_NAME="Candidate Dashboard AAIRO"
# For production: set ENVIRONMENT=production and DEBUG=False. Production startup
# requires a generated SECRET_KEY, a non-placeholder INITIAL_ADMIN_PASSWORD,
# and an explicit HTTPS-only CORS_ORIGINS list.
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
# Required by Docker Compose. Generate a private local value with: openssl rand -hex 32
# SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aairo_user
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=aairo_db
DATABASE_URL=postgresql+asyncpg://aairo_user:replace-with-local-database-password@localhost:5432/aairo_db
DATABASE_URL_SYNC=postgresql://aairo_user:replace-with-local-database-password@localhost:5432/aairo_db

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=15728640

# AI Configuration (NVIDIA Nemotron by default)
# NVIDIA_API_KEY enables NVIDIA-hosted inference. For a self-hosted
# OpenAI-compatible server, set NVIDIA_BASE_URL to its /v1 endpoint.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Gemini is retained only as an explicit legacy option: AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional real search integrations. YouTube videos require an API key;
# article ranking uses OpenAlex citation counts, not view counts.
YOUTUBE_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# Optional password-reset email delivery (SMTP). Use a provider app password/API relay credential.
# SMTP delivers password recovery, registration welcome, and incomplete-profile emails.
# SMTP credentials are never logged. Registration emails are best-effort after account creation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=False
SMTP_STARTTLS=True
SMTP_TIMEOUT_SECONDS=15
FRONTEND_BASE_URL=http://localhost:5173

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Initial Admin Seed
INITIAL_ADMIN_EMAIL=admin@aairo.ai
INITIAL_ADMIN_PASSWORD=replace-with-strong-local-admin-password
