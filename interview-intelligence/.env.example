# =====================================================================
# INTERVIEW INTELLIGENCE PLATFORM ENVIRONMENT CONFIGURATION
# 100% Free & Open-Source Configuration
# =====================================================================

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL with pgvector for production)
# For local zero-dependency testing, fallback to SQLite is automatically supported
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=interview_intelligence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_intelligence
SQLITE_FALLBACK_URL=sqlite:///./interview_intelligence.db

# Free Local AI Models (Ollama / HuggingFace)
# Primary: NVIDIA Nemotron instruction models (e.g. nemotron-mini:latest or nvidia/nemotron-3-8b)
# Fallback: Qwen2.5-Coder / Mistral / deterministic fallback
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_MODEL=nemotron-mini:latest
FALLBACK_MODEL=qwen2.5:3b
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Ethical Scraping & Rate Limits
SCRAPING_CONCURRENCY=4
DEFAULT_REQUEST_DELAY_SEC=2.0
RESPECT_ROBOTS_TXT=true
USER_AGENT=InterviewIntelligenceBot/1.0 (+https://github.com/aairo/interview-intelligence; ethical academic data collector)

# Authorized API Keys (Optional public/authorized developer tokens, no paid services)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=InterviewIntelligence/1.0

# API Security
API_SECRET_KEY=change-this-in-production-local-secret-key-12345
ADMIN_API_KEY=admin-local-token

# Monitoring
PROMETHEUS_PORT=8001
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
